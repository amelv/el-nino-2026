---
import Layout from "../layouts/Layout.astro";
import ImpactExplorer from "../components/ImpactExplorer";
import type { ImpactRegion } from "../components/WorldMap";
import impacts from "../data/impacts.json";
import regions from "../data/regions.json";

const patternRegions = impacts.regions as ImpactRegion[];
---

<Layout title="Regional El Niño patterns" description="Explore how El Niño and La Niña typically affect regions around the world, season by season.">
  <article class="max-w-6xl">
    <p class="mb-2 text-2xs font-bold uppercase tracking-wide text-primary">Around the world</p>
    <h2 class="mb-3 text-2xl font-bold text-primary-darker">Regional patterns</h2>
    <p class="mb-8 max-w-2xl text-sm text-muted">
      These are typical historical tendencies during El Niño and La Niña. They are not local
      forecasts and they are not guaranteed. Choose a phase and a season to see how the pattern changes.
    </p>

    <ImpactExplorer client:load regions={patternRegions} />

    <section class="mt-10" aria-labelledby="currentHeading">
      <h3 id="currentHeading" class="mb-3 text-lg font-bold text-primary-darker">What NOAA says about this event</h3>
      <div class="grid gap-3 sm:grid-cols-2">
        {regions.regions
          .filter((region) => region.status === "watch")
          .map((region) => (
            <article class="border border-gray-20 bg-white p-5">
              <div class="flex items-start justify-between gap-3">
                <h4 class="font-bold text-primary-darker">{region.name}</h4>
                <span class="tag tag--watch">Advisory</span>
              </div>
              <p class="mt-3 text-sm leading-relaxed">{region.impact}</p>
              <p class="mt-3 text-3xs text-muted">{region.source}</p>
            </article>
          ))}
      </div>
    </section>

    <section class="mt-10" aria-labelledby="cycloneHeading">
      <h3 id="cycloneHeading" class="mb-3 text-lg font-bold text-primary-darker">Tropical cyclone activity</h3>
      <p class="mb-4 max-w-2xl text-sm text-muted">
        How cyclone numbers tend to change during El Niño years compared with non-El Niño years.
      </p>
      <div class="overflow-x-auto border border-gray-20">
        <table class="site-table">
          <thead>
            <tr>
              <th scope="col">Basin</th>
              <th scope="col">During El Niño</th>
              <th scope="col">Other years</th>
            </tr>
          </thead>
          <tbody>
            {impacts.cyclones.rows.map((row) => (
              <tr>
                <td class="font-bold">{row.region}</td>
                <td>{row.elNino}</td>
                <td>{row.nonElNino}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-3xs text-muted">Source: {impacts.cyclones.source}.</p>
    </section>

    <p class="mt-10 text-2xs text-muted">
      Regional pattern data: {impacts.source}. Retrieved {impacts.retrievedAt}. {impacts.note}
    </p>
  </article>
</Layout>
