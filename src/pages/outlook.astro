---
import Layout from "../layouts/Layout.astro";
import OniChart from "../components/OniChart";
import data from "../data/data.json";

const format = (value: number) => `${value > 0 ? "+" : ""}${value.toFixed(2)}°C`;
const rows = data.oni.history.map((row) => ({
  season: row.season,
  anomaly: row.anomaly,
  state: row.anomaly >= 0.5 ? "El Niño" : row.anomaly <= -0.5 ? "La Niña" : "Neutral",
}));
---

<Layout title="El Niño outlook" description="The latest El Niño forecast and recent ocean temperature trend in plain language.">
  <article class="max-w-5xl">
    <p class="mb-2 text-2xs font-bold uppercase tracking-wide text-primary">Looking ahead</p>
    <h2 class="mb-3 text-2xl font-bold text-primary-darker">What may happen next</h2>
    <p class="mb-8 max-w-2xl prose-body">Forecast models show how likely El Niño is. They do not predict the exact weather in a particular place.</p>

    <section class="mb-10" aria-labelledby="forecastHeading">
      <h3 id="forecastHeading" class="mb-4 text-xl font-bold text-primary-darker">Forecast</h3>
      <div class="border border-gray-20 bg-blue-5 p-5">
        <p class="text-md font-bold">Forecasters put the chance of El Niño continuing at {data.forecast.prob}%.</p>
        <p class="mt-2 text-2xs text-muted">Based on the IRI/CCSR outlook. It usually updates once a month.</p>
      </div>
    </section>

    <section class="mb-10" aria-labelledby="oniHeading">
      <h3 id="oniHeading" class="mb-4 text-xl font-bold text-primary-darker">ONI, the main yardstick</h3>
      <p class="mb-4 max-w-2xl text-sm text-muted">
        The ONI is the main measure used to identify El Niño and La Niña. Above +0.5°C means El Niño.
        Below -0.5°C means La Niña. This chart shows the last 12 three-month seasons.
      </p>
      <div class="border border-gray-20 bg-white p-4">
        <OniChart client:load history={data.oni.history} />
      </div>
      <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-3xs text-muted">
        <li><span class="mr-1 inline-block h-3 w-3 align-middle" style="background:#fa9441"></span>Warmer than average</li>
        <li><span class="mr-1 inline-block h-3 w-3 align-middle" style="background:#2a5db0"></span>Cooler than average</li>
        <li>Dashed line: El Niño starts at +0.5°C</li>
      </ul>
    </section>

    <section aria-labelledby="tableHeading">
      <h3 id="tableHeading" class="mb-4 text-xl font-bold text-primary-darker">Recent values</h3>
      <div class="overflow-x-auto border border-gray-20">
        <table class="site-table">
          <thead>
            <tr><th scope="col">Season</th><th scope="col">ONI</th><th scope="col">State</th></tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <td class="font-bold">{row.season}</td>
                <td class="num">{format(row.anomaly)}</td>
                <td>{row.state}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </article>
</Layout>
